
# Echte Kundenrechnungen — NIEMALS ins Repo (DSGVO Art. 6, personenbezogene Daten Dritter)
rechnungen/*
!rechnungen/muster.html
!rechnungen/.gitkeep

# Доступы — репозиторий ПУБЛИЧНЫЙ (GitHub Pages), токен здесь = токен у всех
.env
.env.*
!.env.example

# Python-Cache
__pycache__/
*.pyc

# Сгенерированные референсы студийной сцены (60 МБ, не для Pages)
docs/reference/
# исключение: ролики барса — они идут в дело, а не в мусор
!docs/reference/bars/
!docs/reference/bars/*.mp4
.claude/
*.outdated-*.bak

# Зависимости сборки: puppeteer и парсеры ставились для детектора Impeccable.
# 2257 файлов уехали в публичный репозиторий одним коммитом — их тут быть не должно.
node_modules/
package-lock.json
